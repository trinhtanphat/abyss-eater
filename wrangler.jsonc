{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abyss-eater",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}
