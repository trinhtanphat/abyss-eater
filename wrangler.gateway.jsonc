{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abyss-eater-gateway",
  "main": "gateway/worker.mjs",
  "account_id": "50afb4fd3c4c7a1f3e1bdb7f22d4af7f",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/health"]
  },
  "routes": [
    { "pattern": "abyss-eater.qs3d.site", "custom_domain": true }
  ]
}
